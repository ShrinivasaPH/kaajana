      "line": {
        "kn": "ಪದ್ಮಶ್ರೀ. ಬಿ. ಜೋಗತಿ ಮಂಜಮ್ಮ ಅವರ ಜೀವನಾಧಾರಿತ.",
        "en": "Based on the life of Padmashree B. Jogathi Manjamma."
      },
      "story": {
        "kn": "ಪದ್ಮಶ್ರೀ ಬಿ. ಜೋಗತಿ ಮಂಜಮ್ಮ ಅವರ ಜೀವನವನ್ನು ಆಧರಿಸಿ ರಚಿಸಲಾದ ನಾಟಕ. ಮಂಜಮ್ಮ ಅವರು ತಮ್ಮ ಜೀವನದಲ್ಲಿ ಎದುರಿಸಿದ ಸವಾಲುಗಳು, ಸಾಧನೆಗಳು ಮತ್ತು ಸಮಾಜದ ಮೇಲೆ ಅವರ ಪ್ರಭಾವವನ್ನು ಚಿತ್ರಿಸುತ್ತದೆ.",
        "en": "A play based on the life of Padmashree B. Jogathi Manjamma. It portrays the challenges, achievements, and societal impact of Manjamma’s life."
      },
      "writer": {
        "kn": "ಹಲವು ಕೃತಿಗಳು ಹಾಗೂ ಅವರ ಸಂದರ್ಶನಗಳನ್ನು ಆಧರಿಸಿದ್ದು.",
        "en": "Based on books works and interviews of Manjamma."
      },
      "dir": {
        "kn": "ಡಾ. ಬೇಲೂರು ರಘುನಂದನ್",
        "en": "Dr. Beluru Raghunandan"
      },
      "time": 120,
      "cast": 1,
      "shows": "ಕರ್ನಾಟಕದಾದ್ಯಂತ",
